    "normalise": "dmy_to_iso"
   },
   {
    "order": 2,
    "tool_field": "debit_card_last4",
    "answer_format": "digits",
    "normalise": "digits_only"
   }
  ],
  "max_wrong": 2,
  "max_wrong_scope": "per question (second wrong answer on the same question ends the check)",
  "swap_hint": "day_month_swapped",
  "fail": {
   "outcome": "not_verified",
   "reason": "failed"
  },
  "declined": {
   "outcome": "not_verified",
   "reason": "declined"
  }
 },
