{
 "bank": "Corvane Bank",
 "form": "clean specification stressing calendar and amounts (Sunday-Thursday week, mixed deadline counting, formula floors, European number format)",
 "brief_files": [
  "brief.md"
 ],
 "openapi": "openapi.json",
 "live_compatible": true,
 "variables": [
  "customer_id",
  "first_name",
  "last_name",
  "title",
  "now"
 ],
 "clock": {
  "now_variable": "now",
  "date_format": "YYYY-MM-DDTHH:MM"
 },
 "calendar": {
  "weekend": [
   5,
   6
  ],
  "week_starts": 7,
  "holidays": [
   "2026-11-22",
   "2026-11-23",
   "2026-12-24",
   "2026-12-25",
   "2026-12-27",
   "2026-12-28",
   "2026-12-31",
   "2027-01-01",
   "2027-01-03"
  ],
  "non_holidays": [
   "2026-12-08"
  ],
  "roll_rule": "next_business_day"
 },
 "opening": {
  "text": "Good day, this is the Corvane Bank digital assistant. This call is recorded.",
  "forbidden_before_verification": [
   "late",
   "overdue",
   "debt",
   "arrears",
   "payment"
  ],
  "confirm_question": "Am I speaking with {title} {last_name}?",
  "unclear_asks": 2,
  "unclear_outcome": [
   "not_reached",
   "unconfirmed"
  ]
 },
 "identity": {
  "questions": [
   {
    "order": 1,
    "tool_field": "date_of_birth",
    "answer_format": "date",
    "normalise": "dmy_to_iso"
   },
   {
    "order": 2,
    "tool_field": "phone_last4",
    "answer_format": "digits",
    "normalise": "digits_only"
   }
  ],
  "max_wrong": 3,
  "max_wrong_scope": "total over both questions",
  "swap_hint": "day_month_swapped",
  "fail": {
   "outcome": "not_verified",
   "reason": "id_failed"
  },
  "declined": {
   "outcome": "not_verified",
   "reason": "id_refused"
  }
 },
 "products": {
  "max_count": 3,
  "floor_field": {
   "credit_card": "max(minimum_payment, round_half_up(0.10 * past_due, 2))",
   "personal_loan": "min(instalment_amount, past_due)",
   "car_loan": "ceil(0.25 * past_due) (instalment_amount ignored)"
  },
  "speak_as": {
   "credit_card": "credit card ending {card_last4}",
   "personal_loan": "personal loan",
   "car_loan": "car loan"
  }
 },
 "amount_format": "brief uses 1.234,56 (dot thousands, comma decimals); tools use 1234.56",
 "bands": [
  {
   "name": "early",
   "min_days_late": 1,
   "max_days_late": 15,
   "deadline": {
    "kind": "nth_business_day",
    "n": 12,
    "counted_from": "tomorrow"
   },
   "attempts": 1
  },
  {
   "name": "mid",
   "min_days_late": 16,
   "max_days_late": 45,
   "deadline": {
    "kind": "nth_business_day",
    "n": 7,
    "counted_from": "today"
   },
   "attempts": 2
  },
  {
   "name": "late",
   "min_days_late": 46,
   "max_days_late": 90,
   "deadline": {
    "kind": "nth_business_day",
    "n": 3,
    "counted_from": "today"
   },
   "attempts": 2
  }
 ],
 "attempts": [
  {
   "n": 1,
   "amount": "full (or floor if full already said too much)",
   "date": "last business day of the current Sunday-Saturday week; if today is that day or later, last business day of next week; capped at the product deadline"
  },
  {
   "n": 2,
   "bands": [
    "mid",
    "late"
   ],
   "amount": "floor",
   "date": "deadline"
  }
 ],
