  "confirm_question": "Is that {title} {last_name}?",
  "unclear_asks": 2,
  "unclear_outcome": [
   "not_reached",
   "unclear_id"
  ]
 },
 "identity": {
  "questions": [
   {
    "order": 1,
    "tool_field": "date_of_birth",
    "answer_format": "date",
    "normalise": "dmy_to_iso"
   },
   {
    "order": 2,
    "tool_field": "phone_last4",
    "answer_format": "digits",
    "normalise": "digits_only"
   }
  ],
  "max_wrong": 3,
  "max_wrong_scope": "total over both questions",
  "swap_hint": "day_month_swapped",
  "pieces_rule": "wait for the rest of a date or number given in pieces; a correction replaces the earlier value",
  "fail": {
   "outcome": "not_verified",
   "reason": "id_failed"
  },
  "declined": {
   "outcome": "not_verified",
   "reason": "id_declined"
  },
  "why_question": "explain once, not a refusal; asking what the call is about counts as a refusal"
 },
