    "reason": "callback_set"
   }
  ]
 },
 "identity": {
  "questions": [
   {
    "order": 1,
    "tool_field": "postcode",
    "ask": "Ask for the postcode.",
    "answer_format": "text",
    "normalise": "none"
   },
   {
    "order": 2,
    "tool_field": "birth_year",
    "ask": "Ask for the year of birth.",
    "answer_format": "digits",
    "normalise": "digits_only"
   }
  ],
  "max_wrong": 2,
  "wrong_counts_rules": [],
