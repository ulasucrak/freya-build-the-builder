    "full_field": "arrears"
   }
  }
 },
 "bands": [
  {
   "name": "A",
   "min_days_late": 1,
   "max_days_late": 10,
   "deadline": {
    "kind": "nth_business_day",
    "n": 5,
    "counted_from": "today_inclusive"
   },
   "attempts": [
    {
     "n": 1,
     "amount": "full",
     "date": "next_business_day",
     "text": ""
    }
   ]
  },
  {
   "name": "B",
   "min_days_late": 11,
   "max_days_late": 90,
   "deadline": {
    "kind": "nth_business_day",
    "n": 3,
    "counted_from": "today"
   },
   "attempts": [
    {
     "n": 1,
     "amount": "50%",
     "date": "deadline",
     "text": ""
    },
    {
     "n": 2,
     "amount": "floor",
     "date": "deadline",
     "text": ""
    },
    {
     "n": 3,
     "amount": "floor",
     "date": "+1_business_days",
     "text": ""
    }
   ]
  },
  {
   "name": "C",
   "min_days_late": 91,
   "max_days_late": 120,
   "deadline": {
    "kind": "calendar_days",
    "n": 11
   },
   "attempts": []
  }
 ],
 "amounts": {
  "min": "floor",
  "max": "full",
  "below_min": "reject",
