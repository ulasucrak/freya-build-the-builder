{
 "source": {
  "briefs": [
   "brief-a.md",
   "brief-b.md"
  ],
  "overrides_applied": []
 },
 "variables": [
  {
   "name": "customer_id",
   "meaning": "id"
  },
  {
   "name": "first_name",
   "meaning": ""
  },
  {
   "name": "last_name",
   "meaning": ""
  },
  {
   "name": "title",
   "meaning": ""
  },
  {
   "name": "now",
   "meaning": "current date and time",
   "example": "2026-10-14T11:00"
  }
 ],
 "clock": {
  "now_variable": "now",
  "timezone": null,
  "date_format": "YYYY-MM-DDTHH:MM"
 },
 "calendar": {
  "weekend": [
   6,
   7
  ],
  "holidays": [
   "2026-10-26",
   "2026-11-11",
   "2026-11-26",
   "2026-12-25",
   "2027-01-01"
  ],
  "roll_rule": "next_business_day"
 },
 "opening": {
  "text": "Say you are a digital assistant calling from Freya Bank and that the call is recorded.",
  "disclosures": [],
  "forbidden_before_verification": [
   "collections",
   "debt",
   "payment"
  ],
  "line": "Hello, this is Freya Bank's digital assistant. This call is recorded. Am I speaking with {title} {last_name}?"
 },
 "third_party": {
  "rules": [
   "Do not say why you are calling."
  ],
  "cases": [
   {
    "trigger": "someone else answers",
    "say": null,
    "action": "callback",
    "outcome": "not_reached",
    "reason": "callback"
   },
   {
    "trigger": "the offered time is outside the window twice",
    "say": null,
    "action": "end",
    "outcome": "not_reached",
    "reason": "no_callback"
   },
   {
    "trigger": "wrong number",
    "say": null,
    "action": "end",
    "outcome": "not_reached",
    "reason": "wrong_number"
   },
   {
    "trigger": "the customer has died",
    "say": "I am sorry for your loss.",
    "action": "end",
    "outcome": "not_reached",
    "reason": "deceased"
   }
  ]
 },
 "identity": {
  "questions": [
   {
    "order": 1,
    "tool_field": "date_of_birth",
    "ask": "Ask for the date of birth.",
    "answer_format": "date",
    "normalise": "dmy_to_iso"
   },
   {
    "order": 2,
    "tool_field": "phone_last4",
    "ask": "Ask for the last four digits of the phone number on file.",
    "answer_format": "digits",
    "normalise": "digits_only"
   }
  ],
  "max_wrong": 3,
  "wrong_counts_rules": [
   "If verify_identity returns hint day_month_swapped, ask the month as a word. Not a wrong answer."
  ],
  "fail": {
   "outcome": "not_verified",
   "reason": "failed",
   "say": "Tell the customer to use the mobile app or a branch."
  }
 },
 "products": {
  "max_count": 3,
  "order": "as_returned",
  "types": {
   "credit_card": {
    "speak_as": "credit card ending {card_last4}",
    "floor_field": "minimum_payment",
    "full_field": "past_due"
   },
   "personal_loan": {
    "speak_as": "personal loan",
    "floor_field": "instalment_amount",
    "full_field": "past_due"
   },
   "car_loan": {
    "speak_as": "car loan",
    "floor_field": "instalment_amount",
    "full_field": "past_due"
   }
  }
 },
 "bands": [
  {
   "name": "early",
   "min_days_late": 1,
   "max_days_late": 7,
   "deadline": {
    "kind": "nth_business_day",
    "n": 12,
    "counted_from": "today"
   },
   "attempts": [
    {
     "n": 1,
     "amount": "full",
     "date": "end_of_week_business_day",
     "text": "propose the last business day of this week"
    }
   ]
  },
  {
   "name": "late",
   "min_days_late": 8,
   "max_days_late": 45,
   "deadline": {
    "kind": "nth_business_day",
    "n": 7,
    "counted_from": "today"
   },
   "attempts": [
    {
     "n": 1,
     "amount": "full",
     "date": "end_of_week_business_day",
     "text": ""
    },
    {
     "n": 2,
     "amount": "floor",
     "date": "deadline",
     "text": ""
    }
   ]
  }
 ],
 "amounts": {
  "min": "floor",
  "max": "full",
  "below_min": "reject",
  "ask_open_amount": false,
  "rules": [
   "Ask for the full past-due amount first."
  ]
 },
 "dates": {
  "customer_date_after_deadline": "Offer the deadline.",
  "vague_date": "Ask once for the exact day.",
  "rules": [],
  "next_weekday": "following_week"
 },
 "promise": {
  "readback": "Read back and ask Do you confirm?",
  "confirm_required": true,
  "retry_on_failure": 1,
  "success_say": "You will receive a text message confirming this promise.",
  "failure_say": "say you could not record it",
  "per_product": true
 },
 "callback": {
  "days": [
   "today",
   "next_business_day"
  ],
  "start": "10:00",
  "end": "19:00",
  "end_inclusive": true,
  "must_be_after_now": true
 },
 "triggers": [
  {
   "name": "hardship",
   "detect": "illness, death in the family, job loss",
   "action": "transfer",
   "queue": "support",
   "outcome": "transferred",
   "reason": "support",
   "note_reason": "hardship",
   "say": null,
   "precedence": 1
  },
  {
   "name": "already_paid",
   "detect": "I already paid",
   "action": "note",
   "queue": null,
   "outcome": "paid",
   "reason": null,
   "note_reason": "paid",
   "say": null,
   "precedence": 2
  },
  {
   "name": "dispute",
   "detect": "not my debt",
   "action": "note",
   "queue": null,
   "outcome": "no_promise",
   "reason": "dispute",
   "note_reason": "dispute",
   "say": null,
   "precedence": 3
  },
  {
   "name": "restructuring",
   "detect": "new payment plan",
   "action": "transfer",
   "queue": "restructuring",
   "outcome": "transferred",
   "reason": "restructuring",
   "note_reason": null,
   "say": null,
   "precedence": 4
  },
  {
   "name": "human",
   "detect": "asks for a human",
   "action": "transfer",
   "queue": "general",
   "outcome": "transferred",
   "reason": "human",
   "note_reason": null,
   "say": null,
   "precedence": 5
  }
 ],
 "notes": {
  "tool_reasons": [
   "refused",
   "hardship",
   "dispute",
   "paid",
   "service_error"
  ],
  "when": "For each product without a promise call add_note.",
  "forbidden_on_transfer": true
 },
 "outcomes": {
  "table": [
   {
    "outcome": "promise",
    "reason": null,
    "when": "at least one promise was recorded"
   },
   {
    "outcome": "paid",
    "reason": null,
    "when": "rule 39"
   },
   {
    "outcome": "transferred",
    "reason": "restructuring, human, support",
    "when": "rules 41, 42, 32"
   },
   {
    "outcome": "no_promise",
    "reason": "refused, hardship, dispute, service_error",
    "when": "rules 31 and 45, 32, 40, 37"
   },
   {
    "outcome": "not_verified",
    "reason": "failed, declined",
    "when": "rules 14, 15"
   },
   {
    "outcome": "not_reached",
    "reason": "callback, no_callback, wrong_number, deceased, unclear",
    "when": "rules 6, 7, 8, 9, 3"
   }
  ],
  "precedence": [
   "If a transfer follows a recorded promise, close as transferred."
  ],
  "multi_product": "all paid -> paid, else first non-paid note reason"
 },
 "phrases": {
  "sympathy": "I am sorry to hear that."
 },
