        self.assertEqual(sorted(c["id"] for p in parts for c in p), sorted(c["id"] for c in CASES))
        fams = {(c["brief"], c["family"]) for c in CASES}
        for p in parts:
            self.assertEqual(len(p), 250)
            self.assertTrue(130 <= sum(c["brief"] == "A" for c in p) <= 170)
