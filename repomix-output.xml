        # 50% of the full amount on the deadline, the floor on the deadline, the floor on the next business day
        self.assertEqual([(o["amount"], o["date"]) for o in pr["offers"]],
                         [(500.0, "2027-03-07"), (100.0, "2027-03-07"), (100.0, "2027-03-02")])

