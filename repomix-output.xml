<file path="build-the-builder-v3/build-the-builder/builder/codegen/close_request.py">
# Pre-hook of the model's close_call. The model never closes the call itself: its close_call is a close REQUEST.
# The chosen outcome and reason are recorded, the request is stopped, and routing leaves the step for close_check
# (a code node). close_check runs after every tool call of the turn, on the merged variables, so a close never
# goes out before, or together with, another write; the engine sends close_call from close_api as the last call.
config = extra
body = body_of(config)
# every model close_call is stopped here and counted, so final_close_pre can tell a failed engine close apart
vset(vs, "w_close_reqs", str(int(num(vget(vs, "w_close_reqs", 0))) + 1))
# in the wrap-up step the to-do list is binding: while notes are missing the close is refused (twice at most, so a
# model that never sends them cannot keep the call open; the turn cap closes it in the end)
held = int(num(vget(vs, "w_close_holds", 0)))
missing = missing_notes(vs, collect_facts(vs)) if int(num(vget(vs, "w_wrap_rounds", 0))) >= 1 and held < 2 else []
if missing:
    vset(vs, "w_close_holds", str(held + 1))
    block_request(config, vs, "w_close_block", dict(code="notes-missing", message="The call is not closed yet: these products have no recorded promise and no note: " + ", ".join(missing) + ".",
                  next="Call add_note for each of them now, one per message, with the reason that applies from the conversation. Then call close_call again."), "close_call")
else:
    vset(vs, "w_close_req_outcome", str(body.get(nm("close_outcome", "outcome")) or ""))
    r = str(body.get(nm("close_reason", "reason")) or "")
    vset(vs, "w_close_req_reason", "" if r.startswith("{") else r)
    vset(vs, "w_close_requested", "yes")
    block_request(config, vs, "w_close_block", dict(code="closing", message="The call is being closed by the system.",
                  next="Say nothing more unless you are asked to do something before the close."), "close_call")
</file>

<file path="build-the-builder-v3/build-the-builder/builder/codegen/final_close_pre.py">
# Pre-hook of the end-of-call safety net: send close_call only when no close_call went through during the call.
# The engine's close (finish -> close_api, w_close_sent) counts unless the bank's answer says it failed: a failure
# count beyond the model's close requests (all stopped, counted in w_close_reqs) or an answer that is not ok. Then
# the safety net sends it again with the facts' outcome, else the one finish chose. Otherwise the request is stopped.
config = extra
body = body_of(config)
tool = nm("close_tool", "close_call")
n_ok = num(vget(vs, tool + "_success_count", 0))
bad = str(vget(vs, "w_close_sent")) == "yes" and (num(vget(vs, tool + "_failure_count", 0)) > num(vget(vs, "w_close_reqs", 0))
                                                  or (n_ok > 0 and not var_ok(vs, tool, nm("close_ok", "ok"))))
done = not bad and (str(vget(vs, "w_close_done")) == "yes" or n_ok > 0 or num(vget(vs, nm("close_node", "close_api") + "_success_count", 0)) > 0)
res = compute_closing(collect_facts(vs), RT) if not done else dict()
if bad and (not res.get("outcome") or res.get("source") in ("llm", "")):
    res = dict(outcome=vget(vs, "w_close_outcome"), reason=vget(vs, "w_close_reason"), source="finish")
if done or not res.get("outcome") or res.get("source") in ("llm", ""):
    block_request(config, vs, "w_final_block", dict(code="skipped"))
else:
    body[nm("close_outcome", "outcome")] = res.get("outcome")
    if res.get("reason"):
        body[nm("close_reason", "reason")] = res.get("reason")
    else:
        body.pop(nm("close_reason", "reason"), None)
