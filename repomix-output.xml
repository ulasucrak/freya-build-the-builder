        # said on a Friday: attempt 1 moves to the last business day of next week
        prod = O.products_for_case(self.p, [{"product_id": "p1", "type": "car_loan", "past_due": 75.0, "days_late": 3,
                                             "instalment_amount": 25.0}], "2026-10-16T10:00")[0]
