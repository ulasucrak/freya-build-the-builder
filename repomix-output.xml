def changes_policy():
    """brief-b with the new-style '[changes ...]' marks (as the v5 extraction writes them)."""
    q = copy.deepcopy(TG.raw("brief-b"))
    for r in q["rules"]:
        r["text"] = re.sub(r"\[overrides ", "[changes ", r["text"])
        if r["text"].startswith("[changes brief-a.28]"):
