def gp_words(n, tr):
    n = int(n)
    if n == 0:
        return TR_ONES[0] if tr else EN_SMALL[0]
    out = []
    for v, wtr, wen in ((10 ** 12, "trilyon", "trillion"), (10 ** 9, "milyar", "billion"), (10 ** 6, "milyon", "million"),
                        (1000, "bin", "thousand"), (1, "", "")):
