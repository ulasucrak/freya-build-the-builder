                    return res
            if "err" in box:
                res["error"] = box["err"]
                return res
            rows, sim_id, _it, status, took, med = box["out"]
            res["simulation_id"] = sim_id
            res["status"] = status
            res["median_slowest_turn_s"] = med
            for r in rows:
                if not r.get("pass") and r.get("call_id"):
