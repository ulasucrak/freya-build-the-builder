                                "/create_promise": {"post": {}}, "/close_call": {"post": {}}}}


def generic_policy():
    tools = {}
    for path, ops in GENERIC_OPENAPI["paths"].items():
        op = ops["post"]
        props = op["requestBody"]["content"]["application/json"]["schema"]["properties"]
