<file path="build-the-builder-v3/build-the-builder/run_edge.sh">
#!/usr/bin/env bash
# Edge-case test: tricky customers, 2 runs each, against this builder's agent.
#   bash run_edge.sh            test the agent this folder built last (builds one first if there is none)
#   bash run_edge.sh --build    build a fresh agent from Brief A+B first
#   bash run_edge.sh --quick    only the 54 hand-written cases (default: all 130, about 60-80 minutes)
#   bash run_edge.sh --focus    the focus cases (fixes of the 96/99 run, holidays, and their guards), 3 runs each
#   bash run_edge.sh --large    250 cases (all of the above plus the same templates on more customers), 1 run each, about 90 minutes
#   bash run_edge.sh --days     the same situations on other call days (Friday, before a holiday, Christmas, evening), 2 runs each
#   AGENT_ID=<id> bash run_edge.sh   test that agent instead
# Results: results/edge-report.txt (readable) and results/run-edge.json (details, call ids).
set -e
cd "$(dirname "$0")"
mkdir -p results
[ -f env.sh ] || { [ -f "$HOME/BuildTheBuilder/env.sh" ] && cp "$HOME/BuildTheBuilder/env.sh" env.sh; }
[ -f env.sh ] || { echo "env.sh missing: copy env.example to env.sh and put your keys in it."; exit 1; }
source env.sh
if [ ! -x .venv/bin/python ]; then
  if command -v uv >/dev/null; then uv venv -q --python 3.12 .venv && uv pip install -q --python .venv/bin/python -r requirements.txt
  else python3.12 -m venv .venv && .venv/bin/python -m pip install -q -r requirements.txt; fi
fi
PY=.venv/bin/python
exec > >(tee results/edge-report.txt) 2>&1
echo "=== EDGE TEST $(date) ==="
if [[ " $* " == *" --build "* ]] || [ ! -f .freya-agents.json ]; then
  $PY build.py briefs/brief-a.md briefs/brief-b.md --openapi tools/openapi.json
fi
# the phone agent, not the build's "-selftest" copy (fake bank, needs scenario_json); AGENT_ID=... overrides
AGENT=${AGENT_ID:-$($PY -c "import json;print([v for k,v in json.load(open('.freya-agents.json')).items() if not k.endswith('-selftest')][-1]['agent_id'])")}
echo "agent_id: $AGENT"
$PY tools/edge_cases.py
SET=results/edge-cases.json; REPS=2; OUT=results/run-edge.json
[[ " $* " == *" --quick "* ]] && SET=results/edge-cases-quick.json
[[ " $* " == *" --focus "* ]] && SET=results/edge-cases-focus.json && REPS=3 && OUT=results/run-edge-focus.json
[[ " $* " == *" --days "* ]] && SET=results/edge-cases-days.json && OUT=results/run-edge-days.json
[[ " $* " == *" --large "* ]] && SET=results/edge-cases-250.json && REPS=1 && OUT=results/run-edge-250.json
$PY tools/run_cases.py "$AGENT" --cases "$SET" --reps $REPS --out $OUT
echo "=== DONE $(date) ==="
