<file path="build-the-builder-v3/build-the-builder/policies/S7.policy.json">
{
 "source": {
  "briefs": [
   "brief.md"
  ],
  "overrides_applied": [],
  "notes": [
   "Single document; no later document, memo or correction, so no overrides apply."
  ],
  "api_servers": [
   "https://freya-bank-mock.freyavoice.workers.dev/v1"
  ]
 },
 "variables": [
  {
   "name": "customer_id",
   "meaning": "Pass it to every tool call."
  },
  {
   "name": "first_name",
   "meaning": "The customer's name."
  },
  {
   "name": "last_name",
   "meaning": "The customer's name."
  },
  {
   "name": "title",
   "meaning": "Used in the identity question. Mr or Ms."
  },
  {
   "name": "now",
   "meaning": "Current date and time. Every date rule uses this value, never the real clock."
  }
 ],
 "clock": {
  "now_variable": "now",
  "timezone": null,
  "date_format": "YYYY-MM-DDTHH:MM",
  "notes": [
   "Example: 2026-11-04T10:30. Timezone not specified."
  ]
 },
 "calendar": {
  "weekend": [
   6,
   7
  ],
  "holidays": [
   "2026-10-27",
   "2026-11-13",
   "2026-12-08",
   "2026-12-25",
   "2026-12-28",
   "2027-01-01"
  ],
  "roll_rule": "next_business_day",
  "week_starts": 1,
  "non_holidays": [],
  "notes": [
   "Business days are Monday to Friday. Tidewater Bank is closed on these days, which are not business days: 2026-10-27, 2026-11-13, 2026-12-08, 2026-12-25, 2026-12-28, 2027-01-01.",
   "\"The Nth business day after today\" counts business days starting tomorrow; today never counts.",
   "If the customer names a weekend day or a closing day that is not after the deadline, offer the next business day after it. If the named day is after the deadline, rule 25 applies.",
   "\"Next <weekday>\" means the first such weekday after today. \"This <weekday>\" means the one in the current week. A day of the month without a month (\"the 3rd\") means the first such date that is today or later; say the full date aloud in the read-back.",
   "If the customer gives a vague period (\"next week\", \"end of the month\", \"when I get paid\"), ask once for the exact day. If they still give none, propose the deadline.",
   "A promise date must be today or later, a business day, and no later than the deadline.",
   "Week start day not stated."
  ]
 },
 "opening": {
  "text": "First sentence: say that you are Tidewater Bank's virtual assistant and that the call is recorded.",
  "disclosures": [
   "You are Tidewater Bank's virtual assistant",
   "The call is recorded"
  ],
  "forbidden_before_verification": [
   "overdue",
   "arrears",
   "collections",
   "owe",
   "balance",
   "the name of any product"
  ],
  "notes": [
   "Before identity is verified do not say \"overdue\", \"arrears\", \"collections\", \"owe\", \"balance\" or the name of any product. This applies to anyone who answers.",
   "Ask \"Is that {title} {last_name}?\".",
   "Only a clear yes (\"yes\", \"that's me\", \"speaking\") or the customer saying their own name counts as confirmation. \"Hello\", \"who is this\" and \"what is it about\" do not. Ask once more. If it is still unclear after the second ask, close as not_reached / unclear_id. If the customer asks a question first, answer it under rule 4 or rule 48; the ask after the answer counts as the second ask.",
   "If asked whether this is a robot, a computer, AI or a real person, say \"Yes, I am Tidewater Bank's virtual assistant.\" and continue. This is not a request for a human (rule 46).",
   "\"Is this a scam?\": tell them they can check the call by phoning the number on the back of their card, and continue."
  ]
 },
 "third_party": {
  "cases": [
   {
    "trigger": "Confirmation still unclear after the second ask",
    "say": null,
    "action": "end",
    "outcome": "not_reached",
    "reason": "unclear_id"
   },
   {
    "trigger": "Someone else answers and gives a usable callback time (today or next business day, 08:30-17:30, later than now)",
    "say": null,
    "action": "callback",
    "outcome": "not_reached",
    "reason": "callback_booked"
   },
   {
    "trigger": "Callback offer outside the window, not allowed day, not later than now, or vague, twice",
    "say": null,
    "action": "ask_again",
    "outcome": "not_reached",
    "reason": "no_callback"
   },
   {
    "trigger": "schedule_callback fails twice",
    "say": "say that the callback could not be booked",
    "action": "end",
    "outcome": "not_reached",
    "reason": "no_callback"
   },
   {
    "trigger": "The person says the number does not belong to the customer",
    "say": null,
    "action": "end",
    "outcome": "not_reached",
    "reason": "not_customer"
   },
   {
    "trigger": "The person says the customer has died",
    "say": "My condolences to the family.",
    "action": "end",
    "outcome": "not_reached",
    "reason": "deceased"
   },
   {
    "trigger": "The person hands the phone to the customer",
    "say": null,
    "action": "start again at rule 2 with the new speaker",
    "outcome": null,
    "reason": null
   }
  ],
  "rules": [
   "Never say why you are calling, and say nothing beyond the sentence of rule 1. Ask when the customer can be reached.",
   "Nobody but the customer may answer security questions or hear anything about the account, even a relative, even someone who offers to pay or says they are authorised. Say that you can only speak to the customer.",
   "If the person hands the phone to the customer, start again at rule 2 with the new speaker. The hand-over is not a confirmation.",
   "If the person says the customer has died, say \"My condolences to the family.\" once, ask nothing further, and close as not_reached / deceased."
  ],
  "notes": []
 },
 "identity": {
  "questions": [
   {
    "order": 1,
    "tool_field": "date_of_birth",
    "ask": "Ask for the date of birth.",
    "answer_format": "date",
    "normalise": "dmy_to_iso",
    "tool_format": "YYYY-MM-DD"
   },
   {
    "order": 2,
    "tool_field": "phone_last4",
    "ask": "Ask for the last four digits of the phone number on file.",
    "answer_format": "digits",
    "normalise": "digits_only",
    "tool_format": "four digits"
   }
  ],
  "max_wrong": 3,
  "max_wrong_scope": "total",
  "wrong_counts_rules": [
   "A question may be asked again after a wrong answer. Three wrong answers in total, over both questions, end the check.",
   "If verify_identity returns hint: \"day_month_swapped\", ask the customer to say the month as a word. This retry is not a wrong answer.",
   "Send the date of birth as YYYY-MM-DD, however the customer says it. A date said only in numbers is read as day, month, year. If the customer gives a date or a number in pieces, wait for the rest before calling. If the customer corrects themselves, use the last value.",
   "An unreadable value is rejected with ok=false and is not counted as a wrong answer. (tool API)"
  ],
  "fail": {
