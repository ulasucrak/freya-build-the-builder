class Clock:
    def __init__(self):
        self.t = 0.0

    def __call__(self):
        return self.t

    def advance(self, s):
        self.t += s


def base_workflow(policy):
    return {"initial_node": "greet", "system_prompt": "You are the agent of {{bank}}.",
            "nodes": {"greet": {"name": "greet", "node_type": "conversation",
                                "task_message": "Greet {{first_name}}. Call verify_identity.",
