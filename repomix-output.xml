    "/voice/v1/statement.week.decide": {
      "post": {
        "operationId": "statement_week_decide",
        "summary": "Preview the statement and due dates the card would get with a new statement week (changes nothing).",
        "description": "Preview only: returns the first statement date (statementDate), its due date (statementDueDate, not lastPayDate) and the statement day the card would get with the requested week. It does not change the card. Requesting the card's current week, an unknown card or a week outside 1-4 gives HTTP 400 INVALID_ARGUMENTS_ERROR. responseCode 0 = fine. HTTP 500 FBE00099 = technical error.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "description": "Service fields: cardNumber (string, required): Card number exactly as cards_list returned it in cards[].cardNumber (masked in the test environment, e.g. \"540000******1234\"). Never rebuilt from digits the caller says; newStatementWeek (integer, required): Requested statement week, 1 to 4 (week of the month the statement is cut). Number or string accepted. Must differ from the card's current statementWeek; statementDay (integer, required): The card's current statementDay from statement_week_get (required by the request model; the bank recalculates the day itself).",
                    "properties": {
                      "cardNumber": {
                        "type": "string",
                        "description": "Card number exactly as cards_list returned it in cards[].cardNumber (masked in the test environment, e.g. \"540000******1234\"). Never rebuilt from digits the caller says."
                      },
                      "newStatementWeek": {
                        "type": "integer",
                        "description": "Requested statement week, 1 to 4 (week of the month the statement is cut). Number or string accepted. Must differ from the card's current statementWeek.",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "statementDay": {
                        "type": "integer",
                        "description": "The card's current statementDay from statement_week_get (required by the request model; the bank recalculates the day itself)."
                      }
                    },
                    "required": [
                      "cardNumber",
                      "newStatementWeek",
                      "statementDay"
                    ]
                  },
                  "call": {
                    "type": "object",
                    "description": "Call metadata the bank logs on its side. Nothing depends on it and the test environment does not check it.",
                    "properties": {
                      "ani": {
                        "type": "string",
                        "description": "Caller's phone number."
                      },
                      "lang": {
                        "type": "string",
                        "description": "Call language; \"tr\".",
                        "default": "tr"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The dates the card would get with the requested week.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "statementDate": {
                          "type": "string",
                          "description": "First statement date under the requested week. Date as dd.MM.yyyy, e.g. 05.11.2026."
                        },
                        "statementDueDate": {
                          "type": "string",
                          "description": "Due date of that statement. Date as dd.MM.yyyy, e.g. 05.11.2026."
                        },
                        "statementDay": {
                          "type": "integer",
                          "description": "Statement day of the month under the requested week."
                        },
                        "responseCode": {
                          "type": "integer",
                          "description": "0 = fine."
                        },
                        "responseMessage": {
                          "type": "string",
