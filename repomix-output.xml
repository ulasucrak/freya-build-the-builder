{
  "openapi": "3.0.3",
  "info": {
    "title": "Tidewater Bank collections tools",
    "version": "0.3-draft",
    "description": "Mock of the bank's systems for the Build the Builder hackathon. We host it. Every call is written to the ledger the scorer reads. The service does not enforce the brief: it records a promise on a holiday or past the deadline without complaint. Following the brief is the agent's job. The seven tool calls need no key: the customer_id in the body is the secret of one call. Synthetic holdout fixture S7: fields and enums identical to the kit tool API so it can be run live."
  },
  "servers": [
    {
      "url": "https://freya-bank-mock.freyavoice.workers.dev/v1"
    }
  ],
  "components": {},
  "paths": {
    "/verify_identity": {
      "post": {
        "summary": "Check one security answer. Three wrong answers in total end the check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "date_of_birth",
                      "phone_last4"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits."
                  }
                },
                "required": [
                  "customer_id",
                  "field",
                  "answer"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "wrong_answers_left": {
                      "type": "integer"
                    },
                    "all_verified": {
                      "type": "boolean"
                    },
                    "hint": {
                      "type": "string",
                      "enum": [
                        "day_month_swapped"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/get_account": {
      "post": {
        "summary": "The late products. Refused until both questions are passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "credit_card",
