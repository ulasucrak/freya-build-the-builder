            def flaky(wid, path):
                state["n"] += 1
                if state["n"] == 1:
                    raise RuntimeError("GET -> 502")
                return inner(wid, path)
            ns.export_workflow = flaky
            return ns
        f.freya = freya
        b, res = self.build(f, no_test=True)
        self.assertEqual(state["n"], 2)
        self.assertTrue(res["export"] and os.path.exists(res["export"]))

