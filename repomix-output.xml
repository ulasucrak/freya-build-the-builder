        self.assertIn("exported", txt)
        self.assertIn("self-test skipped (--no-test)", txt)
        self.assertIn("FINAL RESULT: status=ok", txt)
        self.assertTrue(pathlib.Path(res["trace"]).name.startswith("my-brief-"))
