        self.assertEqual(O.parse_amount("12 500.50 EUR"), 12500.5)

    def test_4_clock_time_or_number_after_at_or_by_is_not_the_amount(self):
        self.assertEqual(O.parse_amount("two hundred euros at 3"), 200)
